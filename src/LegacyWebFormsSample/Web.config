<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
    <sessionState mode="InProc" cookieless="false" timeout="20" />
    <authentication mode="Forms">
      <forms loginUrl="~/Pages/Login.aspx" defaultUrl="~/Pages/Default.aspx" timeout="20" slidingExpiration="true" />
    </authentication>
    <authorization>
      <allow users="*" />
    </authorization>
    <pages validateRequest="false"><controls>
        <add tagPrefix="ajaxToolkit" assembly="AjaxControlToolkit" namespace="AjaxControlToolkit" />
      </controls></pages>
  </system.web>

  <location path="Pages/DataAccess.aspx">
    <system.web>
      <authorization>
        <deny users="?" />
        <allow users="*" />
      </authorization>
    </system.web>
  </location>

  <location path="Pages/Profile.aspx">
    <system.web>
      <authorization>
        <deny users="?" />
        <allow users="*" />
      </authorization>
    </system.web>
  </location>

  <appSettings>
    <add key="LegacyAppName" value="Legacy Web Forms Migration Sample" />
    <add key="LegacyCustomerServiceUrl" value="http://localhost:60172/LegacyCustomerService.svc" />
    <add key="LegacyTrustedApplicationName" value="LegacyWebFormsSample" />
    <add key="LegacyTrustedApplicationSecret" value="legacy-sample-secret" />
  </appSettings>
</configuration>
