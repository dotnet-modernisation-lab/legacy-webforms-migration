<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
    <authentication mode="None" />
    <authorization>
      <allow users="*" />
    </authorization>
  </system.web>

  <system.serviceModel>
    <services>
      <service name="LegacyDataService.LegacyDataService.LegacyCustomerService" behaviorConfiguration="LegacyCustomerServiceBehavior">
        <endpoint address="" binding="basicHttpBinding" contract="LegacyDataService.LegacyDataService.ILegacyCustomerService" />
      </service>
    </services>
    <behaviors>
      <serviceBehaviors>
        <behavior name="LegacyCustomerServiceBehavior">
          <serviceMetadata httpGetEnabled="true" />
        </behavior>
      </serviceBehaviors>
    </behaviors>
  </system.serviceModel>

  <appSettings>
    <add key="LegacyCustomerFixturePath" value="App_Data\SampleData\Customers.json" />
    <add key="LegacyTrustedApplicationName" value="LegacyWebFormsSample" />
    <add key="LegacyTrustedApplicationSecret" value="legacy-sample-secret" />
  </appSettings>
</configuration>
